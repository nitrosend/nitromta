# The engine as a systemd service, holding no more privilege than it needs:
# its own user, which nitromta.sysusers creates, and
# CAP_NET_BIND_SERVICE alone, for listeners below port 1024. The engine
# refuses to start as root or with any other capability. It keeps its store
# under /var/lib/nitromta and its admin socket under /run/nitromta, as its
# configuration names them, and reads that configuration, its certificates
# and its keys from /etc/nitromta. Nothing it can write can be run.
#
# Its stop waits for the attempts under way, up to [scheduler] drain_seconds
# (20 by default), so systemd waits longer than that before it kills it.

[Unit]
Description=NitroMTA mail engine
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=exec
User=nitromta
Group=nitromta
ExecStart=/usr/bin/nitromta run --config /etc/nitromta/config.toml
# A renewed certificate is read again without a restart: a renewal's hook
# runs `systemctl reload nitromta`.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
LimitNOFILE=65536
# The engine turns core dumps off itself too: one would hold its keys.
LimitCORE=0
UMask=0077

StateDirectory=nitromta
StateDirectoryMode=0700
RuntimeDirectory=nitromta
RuntimeDirectoryMode=0750
ConfigurationDirectory=nitromta

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# memfd_create would let code written to memory run despite
# MemoryDenyWriteExecute.
SystemCallFilter=~@privileged @resources memfd_create
NoExecPaths=/var/lib/nitromta /run/nitromta /tmp /var/tmp /dev/shm

[Install]
WantedBy=multi-user.target
