+int LazyFS::lfs_mknod (const char* path, mode_t mode, dev_t rdev) {
+
+    std::shared_lock<std::shared_mutex> lock (cache_command_lock);
+
+    int res = S_ISFIFO (mode) ? mkfifo (path, mode) : mknod (path, mode, rdev);
+    if (res == -1)
+        return -errno;
+
+    return 0;
+}
+
+int LazyFS::lfs_statfs (const char* path, struct statvfs* stbuf) {
+
+    int res = statvfs (path, stbuf);
+    if (res == -1)
+        return -errno;
+
+    return 0;
